# Chiave dell'API di Anthropic (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Connessione al database, con un utente in SOLA LETTURA (vedi README)
# PostgreSQL:  postgresql://utente:password@host:5432/nomedb
# MySQL:       mysql://utente:password@host:3306/nomedb
# SQL Server:  mssql+pyodbc://...   (richiede il driver ODBC)
# SQLite:      sqlite:///percorso/del/file.db
DATABASE_URL=postgresql://lettore:password@localhost:5432/miodb

# Password per accedere all'app dal browser (nome utente qualsiasi)
APP_PASSWORD=cambiami

# --- Gestione delle connessioni dall'interfaccia (pagina Connessioni) ---
# Password in più per creare, modificare ed eliminare connessioni: tienila diversa da APP_PASSWORD
# ADMIN_PASSWORD=
# Chiave che cifra le password dei database salvate nell'app. Generala con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Conservala: se la perdi o la cambi, le connessioni salvate vanno reinserite.
# CHIAVE_CIFRATURA=

# --- Facoltativi ---
# CLAUDE_MODEL=claude-opus-5-5     # predefinito; oppure claude-sonnet-5-5 o claude-haiku-5-5 (anche dalla pagina Impostazioni)
# CLAUDE_EFFORT=medium             # predefinito; low | medium | high | xhigh | max (anche dalla pagina Impostazioni)
# SOLO_METADATI=false              # true = Claude vede solo la struttura del DB, mai i dati
# MAX_RIGHE_ESPLORAZIONE=50        # righe massime che Claude può leggere per query
# MAX_RIGHE_RISULTATI=500          # righe massime mostrate quando premi "Esegui"
# TIMEOUT_SECONDI=15               # durata massima di ogni query
# CONTESTO_PATH=contesto.md        # regole di business (facoltativo)
# CREDITO_INIZIALE_USD=5           # credito acquistato: la pagina /consumi mostra il residuo stimato
# CONSUMI_PATH=consumi.db          # file SQLite dove vengono registrati i token di ogni chiamata
# IMPOSTAZIONI_PATH=impostazioni.json  # dove la pagina Impostazioni salva modello ed effort
# DATI_PATH=app.db                 # archivio SQLite: connessioni, progetti e query salvate (solo SQL, mai i risultati)
# PROGETTI_PATH=progetti.db        # vecchio archivio: al primo avvio viene copiato in app.db
